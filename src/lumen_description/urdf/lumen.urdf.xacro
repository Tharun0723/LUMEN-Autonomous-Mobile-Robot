<robot name="lumen"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Chassis subsystem -->
  <xacro:include filename="$(find lumen_description)/urdf/chassis.xacro"/>

  <!-- Four-wheel skid-steer subsystem -->
  <xacro:include filename="$(find lumen_description)/urdf/wheels.xacro"/>

</robot>



  

